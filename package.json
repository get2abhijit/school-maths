{
  "name": "mathe7-uebungsapp",
  "version": "0.12.0",
  "private": true,
  "description": "Offline adaptive math practice for Grade 7 (G9 BW). No dependencies.",
  "scripts": {
    "bundle": "node tools/bundle-engine.js",
    "build": "node build.js",
    "test": "node build.js && node --test test/*.test.js",
    "test:dev-deps": "npm i --no-save --no-audit --no-fund jsdom@24.1.3 katex@0.16.22",
    "golden": "node tools/bundle-engine.js && node tools/update-golden.js",
    "serve": "node build.js && node tools/serve.js",
    "serve:lan": "node build.js && node tools/serve.js --lan",
    "site": "node build.js && node tools/make-site.js"
  }
}
